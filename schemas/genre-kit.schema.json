{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.a2asset.local/v1/genre-kit.schema.json",
  "title": "genre-kit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kitId",
    "version",
    "genre",
    "requirements"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "kitId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "genre": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "kind",
          "required"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "sprite2d",
              "background2d",
              "animation2d",
              "atlas2d",
              "tilemap2d",
              "ui9slice",
              "vfx2d",
              "audio",
              "font"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "requiredStates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]*$"
            }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "maxLength": 128
      }
    }
  }
}
