{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.a2asset.local/v1/bundle-manifest.schema.json",
  "title": "bundle-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gameId",
    "profileId",
    "buildFingerprint",
    "bindings",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "gameId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "buildFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "kind",
          "files"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "sprite2d",
              "background2d",
              "animation2d",
              "atlas2d",
              "tilemap2d",
              "ui9slice",
              "vfx2d",
              "audio",
              "font"
            ]
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[a-zA-Z0-9_.@/+-]+$"
            }
          },
          "pivot": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "logicalSize": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "placeholder": {
            "type": "boolean"
          },
          "stateClips": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "loop",
                "frames"
              ],
              "properties": {
                "loop": {
                  "type": "boolean"
                },
                "frames": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "file",
                      "durationMs"
                    ],
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1
                      },
                      "durationMs": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "rect": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "minItems": 4,
                        "maxItems": 4
                      },
                      "pivot": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "sourceSize": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "trimOffset": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                }
              }
            }
          },
          "atlasRegion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "rect",
              "rotated"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "rect": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              },
              "rotated": {
                "const": false
              },
              "sourceSize": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2
              },
              "trimOffset": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "nineSlice": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "left",
              "right",
              "top",
              "bottom"
            ],
            "properties": {
              "left": {
                "type": "integer",
                "minimum": 0
              },
              "right": {
                "type": "integer",
                "minimum": 0
              },
              "top": {
                "type": "integer",
                "minimum": 0
              },
              "bottom": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "tilemap": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tileSize",
              "orientation"
            ],
            "properties": {
              "tileSize": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2
              },
              "orientation": {
                "const": "orthogonal"
              }
            }
          },
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sampleRate": {
                "type": "integer",
                "minimum": 1
              },
              "channels": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[a-zA-Z0-9_.@/+-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "licenseNoticePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[a-zA-Z0-9_.@/+-]+$"
    }
  }
}
