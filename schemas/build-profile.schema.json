{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.a2asset.local/v1/build-profile.schema.json",
  "title": "build-profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "target",
    "mode",
    "limits",
    "allowFormats"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "engine",
        "renderer"
      ],
      "properties": {
        "platform": {
          "const": "web"
        },
        "engine": {
          "enum": [
            "cocosairjs",
            "generic-web"
          ]
        },
        "renderer": {
          "enum": [
            "webgl2",
            "canvas2d"
          ]
        },
        "runtimeVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mode": {
      "enum": [
        "preview",
        "production"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTextureSize",
        "maxBundleBytes",
        "maxAtlasCount"
      ],
      "properties": {
        "maxTextureSize": {
          "type": "integer",
          "minimum": 64
        },
        "maxBundleBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "maxAtlasCount": {
          "type": "integer",
          "minimum": 1
        },
        "maxSingleFileBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "allowFormats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "png",
          "webp",
          "json",
          "wav",
          "ogg",
          "mp3",
          "woff2"
        ]
      }
    },
    "colorSpace": {
      "enum": [
        "srgb"
      ]
    },
    "alphaMode": {
      "enum": [
        "straight",
        "premultiplied"
      ]
    }
  }
}
