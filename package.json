{
  "name": "a2asset-toolkit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts && npm run test:runtime",
    "test:contracts": "node --import tsx --test tests/contracts/*.test.ts",
    "test:bridge": "node --import tsx --test tests/bridge/*.test.ts",
    "test:runtime": "node --test tests/runtime/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
